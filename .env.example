# ── Nebius Token Factory ──────────────────────────────────────────────────────
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NANO_MODEL_ID=nvidia/Llama-3.1-Nemotron-Nano-8B-Instruct
ULTRA_MODEL_ID=nvidia/Llama-3.1-Nemotron-Ultra-253B-v1

# ── Nebius Object Storage (S3-compatible — no AWS account needed) ─────────────
# boto3 is used as an S3-compatible client; just change the endpoint URL.
# Get these credentials from Nebius Console → Object Storage → Access Keys.
OBJECT_STORAGE_BUCKET=logtrace-submissions
OBJECT_STORAGE_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_STORAGE_ACCESS_KEY_ID=your-nebius-storage-key-id
NEBIUS_STORAGE_SECRET_KEY=your-nebius-storage-secret

# ── Tavily Search API ─────────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here

# ── Demo ──────────────────────────────────────────────────────────────────────
# The key judges (and demo users) enter in the portal UI → API Key field.
# It is auto-seeded into the api_keys table on startup.
# After deployment the portal is at: http://<your-host>/portal
DEMO_API_KEY=dev-demo-key

# ── Database ──────────────────────────────────────────────────────────────────
# Used by the postgres container AND composed into DATABASE_URL below.
# Use a strong POSTGRES_PASSWORD in production — change it from the default.
POSTGRES_USER=logtrace
POSTGRES_PASSWORD=logtrace
POSTGRES_DB=logtrace

# Local dev (host=localhost). For docker-compose.prod.yml use host=postgres:
#   DATABASE_URL=postgresql+asyncpg://logtrace:<password>@postgres:5432/logtrace
DATABASE_URL=postgresql+asyncpg://logtrace:logtrace@localhost:5432/logtrace

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local dev (host=localhost). For docker-compose.prod.yml use host=redis:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Production deployment ─────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in all values above (no defaults — every key must be set)
# 3. Deploy:          ./scripts/start.sh
# Portal will be available at: http://<your-host>/portal
# Use DEMO_API_KEY value as the API Key in the portal login field.

# ── Tuning (all have defaults — only set to override) ─────────────────────────
# ERROR_SPIKE_THRESHOLD=10
# ERROR_SPIKE_WINDOW_SECONDS=60
# TIME_WINDOW_SECONDS=30
# NANO_BATCH_SIZE=20
# NANO_PARALLEL_CALLS=10
# QA_MAX_TURNS=20

